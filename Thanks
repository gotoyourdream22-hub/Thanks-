            <button class="reset-btn" onclick="resetAllData()">إعادة ضبط الاختيارات</button>
        </div>
    </div>

    <!-- Modal -->
    <div class="modal-overlay" id="modalOverlay">
        <div class="modal-box">
            <button class="close-modal" onclick="closeModal()">✕</button>
            <div class="modal-title" id="modalTitle">ظرف التهنئة 💌</div>
            <div class="modal-message" id="modalMessage">
                أهلاً بكِ يا بطلتنا المتميزة! مبارك حصولك على الدرجة الكاملة في اختبار الوحدة. اختاري جائزتك المفضلة الآن:
            </div>

            <div class="gifts-container" id="giftsContainer">
                <div class="gift-option" onclick="selectGift(this, 'مبلغ مادي (٥ ريال 💵)')">
                    <span>💵 مبلغ مادي (٥ ريال)</span>
                    <span>✨</span>
                </div>
                <div class="gift-option" onclick="selectGift(this, 'هدية رمزية 🎁')">
                    <span>🎁 هدية رمزية</span>
                    <span>✨</span>
                </div>
                <div class="gift-option" onclick="selectGift(this, 'اضافة درجات عند الحاجة (٥ درجات ⭐)')">
                    <span>⭐ إضافة درجات عند الحاجة (٥ درجات)</span>
                    <span>✨</span>
                </div>
            </div>

            <button class="confirm-gift-btn" id="confirmBtn" onclick="confirmGift()">تأكيد واختيار الهدية 🎉</button>

            <div class="success-certificate" id="successCert">
                <h3>🎊 تم توثيق اختيارك بنجاح!</h3>
                <p id="certText" style="font-size: 14px; color: #444; margin-top: 5px;"></p>
                <p style="font-size: 12px; color: #666; margin-top: 10px; font-weight: bold;">الرجاء تصوير هذه الشاشة وإرسالها للمعلمة هدى الحجي بالواتساب 🤍</p>
            </div>
        </div>
    </div>

    <script>
        const students = [
            "فاطمة الحسين",
            "سجى الجبور",
            "سارا بوشلبي",
            "لمى الهبوب",
            "فاطمة الفرط",
            "فاطمة الحسن",
            "رقية السلمان"
        ];

        let currentStudent = "";
        let selectedGiftValue = "";

        function renderStudents() {
            const grid = document.getElementById('studentsGrid');
            grid.innerHTML = '';
            
            students.forEach((name, index) => {
                const savedGift = localStorage.getItem('gift_' + name);
                
                const card = document.createElement('div');
                card.className = 'student-card';
                card.innerHTML = `
                    <div class="student-avatar">👩‍🎓</div>
                    <div class="student-name">${name}</div>
                    <div class="student-score">النتيجة: 5 / 5 ⭐</div>
                    <button class="open-btn" onclick="openEnvelope('${name}')">تعرفي على رسالتك 💌</button>
                    <div class="badge-picked" id="badge_${index}" style="display: ${savedGift ? 'block' : 'none'}">
                        🎁 الهدية المختارة: ${savedGift || ''}
                    </div>
                `;
                grid.appendChild(card);
            });
        }

        function openEnvelope(name) {
            currentStudent = name;
            selectedGiftValue = "";
            
            document.getElementById('modalTitle').innerText = `رسالة خاصة لـ ${name} 🌟`;
            
            // إعادة ضبط الخيارات في النافذة
            const options = document.querySelectorAll('.gift-option');
            options.forEach(opt => opt.classList.remove('selected'));
            document.getElementById('confirmBtn').style.display = 'none';
            document.getElementById('successCert').style.display = 'none';
            document.getElementById('giftsContainer').style.display = 'flex';
            
            const savedGift = localStorage.getItem('gift_' + name);
            if (savedGift) {
                document.getElementById('giftsContainer').style.display = 'none';
                document.getElementById('successCert').style.display = 'block';
                document.getElementById('certText').innerHTML = `الطالبة المتميزة: <b>${name}</b><br>اختارت جائزتها: <b>${savedGift}</b>`;
            }

            document.getElementById('modalOverlay').classList.add('active');
            
            // إطلاق قصاصات احتفالية
            confetti({
                particleCount: 70,
                spread: 60,
                origin: { y: 0.6 }
            });
        }

        function selectGift(element, giftName) {
            const options = document.querySelectorAll('.gift-option');
            options.forEach(opt => opt.classList.remove('selected'));
            element.classList.add('selected');
            selectedGiftValue = giftName;
            document.getElementById('confirmBtn').style.display = 'block';
        }

        function confirmGift() {
            if (!selectedGiftValue) return;
            
            localStorage.setItem('gift_' + currentStudent, selectedGiftValue);
            
            document.getElementById('giftsContainer').style.display = 'none';
            document.getElementById('confirmBtn').style.display = 'none';
            
            const cert = document.getElementById('successCert');
            cert.style.display = 'block';
            document.getElementById('certText').innerHTML = `الطالبة المتميزة: <b>${currentStudent}</b><br>تم اعتماد اختيارك: <b>${selectedGiftValue}</b>`;

            confetti({
                particleCount: 150,
                spread: 100,
                origin: { y: 0.5 }
            });

            renderStudents();
        }

        function closeModal() {
            document.getElementById('modalOverlay').classList.remove('active');
        }

        function resetAllData() {
            if (confirm('هل أنت متأكدة من رغبتك في إعادة ضبط جميع اختيارات الطالبات؟')) {
                students.forEach(name => {
                    localStorage.removeItem('gift_' + name);
                });
                renderStudents();
                alert('تمت إعادة الضبط بنجاح.');
            }
        }

        window.onload = renderStudents;
    </script>
</body>
</html>
